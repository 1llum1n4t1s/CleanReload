{
  "name": "clean-reload",
  "version": "1.0.13",
  "type": "commonjs",
  "description": "ワンクリックで Service Worker・CacheStorage・HTTP キャッシュを完全クリアしてページを再読み込みする Chrome / Firefox 拡張機能",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.1",
    "puppeteer": "^25.7.0",
    "sharp": "^0.35.3",
    "web-ext": "^10.6.0"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "hard-reload",
    "super-reload",
    "cache-bypass"
  ],
  "author": "",
