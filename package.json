{
  "name": "clean-reload",
  "version": "1.0.18",
  "type": "commonjs",
  "packageManager": "pnpm@12.16.1",
  "description": "ワンクリックで Service Worker と HTTP キャッシュをクリアし、Chrome では CacheStorage も削除して再読み込みする拡張機能",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.2",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5",
    "web-ext": "^10.8.0"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "hard-reload",
    "super-reload",
    "cache-bypass"
  ],
  "author": "",
  "license": "MIT"
}
